/*
 * nextflow.config
 * ─────────────────────────────────────────────────────────
 * Profiles:
 *   local  – conda, runs on your WSL machine (default)
 *   docker – Docker containers, local execution
 *   aws    – AWS Batch + S3 (fill in placeholders first)
 */

params {
    samplesheet          = "${projectDir}/data/samplesheet.csv"
    genome               = "${projectDir}/genome/genome.fa"
    gtf                  = "${projectDir}/genome/annotation.gtf"
    hisat2_index         = "${projectDir}/genome/hisat2_index"
    hisat2_index_base    = "GRCm39"
    trimmomatic_adapters = "TruSeq3-PE-2.fa"
    outdir               = "${projectDir}/results"
    contrast             = ["condition", "miR150_inhibition", "negative_control"]
    r_script             = "${projectDir}/scripts/deseq2_analysis.R"
}

process {
    withLabel: 'process_low' {
        cpus   = 2
        memory = '2.GB'
        time   = '2.h'
    }
    withLabel: 'process_medium' {
        cpus   = 2
        memory = '4.GB'
        time   = '4.h'
    }
    withLabel: 'process_high' {
        cpus   = 4
        memory = '5.GB'
        time   = '8.h'
    }
}

profiles {

    local {
        process.executor = 'local'
        conda.enabled    = true
        conda.cacheDir   = "${System.getProperty('user.home')}/.conda/envs"
        docker.enabled   = false
    }

    docker {
        process.executor  = 'local'
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled     = false
    }

    aws {
        process.executor  = 'awsbatch'
        process.queue     = 'rnaseq-batch-queue'
        process.container = 'YOUR_ECR_IMAGE_URI'

        aws {
            region = 'us-east-1'
            batch {
                cliPath = '/home/ec2-user/miniconda3/bin/aws'
                volumes = '/tmp'
            }
        }

        params {
            samplesheet  = 's3://YOUR-BUCKET-NAME/data/samplesheet.csv'
            genome       = 's3://YOUR-BUCKET-NAME/genome/genome.fa'
            gtf          = 's3://YOUR-BUCKET-NAME/genome/annotation.gtf'
            hisat2_index = 's3://YOUR-BUCKET-NAME/genome/hisat2_index'
            outdir       = 's3://YOUR-BUCKET-NAME/results'
            r_script     = 's3://YOUR-BUCKET-NAME/scripts/deseq2_analysis.R'
        }

        docker.enabled = true
        conda.enabled  = false
        workDir        = 's3://YOUR-BUCKET-NAME/work'
    }
}

report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_report.html" }
timeline { enabled = true; overwrite = true; file = "${params.outdir}/timeline.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/trace.txt" }
